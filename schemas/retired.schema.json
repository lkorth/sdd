{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retired.schema.json",
  "title": "One line of sdd/retired.jsonl: a requirement ID that has been used and must not be used again",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(L0_[0-9]{3}|L[12]_[A-Z]{2,4}_[0-9]{3})$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    }
  }
}
